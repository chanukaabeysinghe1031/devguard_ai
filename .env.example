PROJECT_NAME=DevGuard AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
# Optional overrides (defaults shown in Settings).
API_V1_PREFIX=/api/v1
SERVICE_NAME=devguard-api
LOG_FORMAT=json

POSTGRES_DB=devguard
POSTGRES_USER=devguard
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://devguard:change_me@postgres:5432/devguard

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

BACKEND_CORS_ORIGINS=["http://localhost:5173"]
VITE_API_BASE_URL=http://localhost:8000/api/v1

LOG_LEVEL=INFO

# Optional — GitHub Issues API collector (Phase 1 dataset corpus).
# Raises rate limits for scripts/dataset/collect_github_issues.py. Never commit a real token.
GITHUB_TOKEN=

# JWT authentication (Module 3). Generate a strong secret for local use:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ISSUER=devguard-ai
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# File upload storage (Module 5). Local filesystem for development.
# ZIP uploads are deferred (ADR-011 / MASTER_ARCHITECTURE).
FILE_STORAGE_BACKEND=local
FILE_STORAGE_PATH=./storage/uploads
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_FILES_PER_UPLOAD=10

# AI analysis pipeline (Modules 6–8). Deterministic rules/hybrid path is always available.
# For end-to-end grounded diagnosis (Phase 3), enable RAG + LLM and send matching request options.
ENABLE_RAG=true
ENABLE_LLM=true
ENABLE_LOCAL_REASONER=true
ENABLE_EXTERNAL_LLM=true
ENABLE_CONFIDENCE_ROUTING=true
ENABLE_COST_TRACKING=true
ENABLE_LATENCY_BUDGET=true
# background = FastAPI BackgroundTasks after 202; sync = run in-request (tests/dev).
ANALYSIS_EXECUTION_MODE=background
# Module 7 grounded retrieval / reasoning (optional providers).
# RAG_BACKEND=memory keeps an in-process index (tests / offline).
# RAG_BACKEND=chroma uses ChromaDB — set CHROMA_HOST for HTTP (Docker) or leave
# CHROMA_HOST empty to use a local PersistentClient at CHROMA_PERSIST_PATH.
RAG_BACKEND=chroma
# Embedding provider: hash (deterministic tests) | sentence_transformers (real local model)
EMBEDDING_PROVIDER=sentence_transformers
# Real local embedding model (used when EMBEDDING_PROVIDER=sentence_transformers)
# EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_NORMALIZE=true
EMBEDDING_MAX_INPUT_CHARACTERS=12000
EMBEDDING_STRICT_STARTUP_VALIDATION=false
# local = offline grounded reasoner; openai = GPT when OPENAI_API_KEY is set
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BASE_DELAY_MS=500
OPENAI_RETRY_MAX_DELAY_MS=8000
OPENAI_CIRCUIT_BREAKER_FAILURES=5
OPENAI_CIRCUIT_BREAKER_RESET_SECONDS=60
CHROMA_PERSIST_PATH=./storage/chroma
# Inside Docker Compose backend: CHROMA_HOST=chroma, CHROMA_PORT=8000
# From the host (Mac scripts against published port): CHROMA_HOST=localhost, CHROMA_PORT=8001
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=devguard_knowledge
# Optional second collection for federated retrieval (e.g. research corpus).
CHROMA_SECONDARY_COLLECTION_NAME=
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
KNOWLEDGE_BASE_PATH=../knowledge_base
RAG_TOP_K=10
RAG_CONTEXT_K=5

# Module 8 confidence/cost routing.
# Allowed modes: rules_only, rules_rag, llm_only, rag_llm, confidence_routed
DEFAULT_EXECUTION_MODE=confidence_routed
# Empty money values mean unavailable/null — never treat blank as zero.
DEFAULT_BUDGET_USD=
MAX_BUDGET_USD_PER_ANALYSIS=
DEFAULT_LATENCY_LIMIT_MS=30000
MAX_LATENCY_LIMIT_MS=60000
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_MEDIUM_THRESHOLD=0.60
UNCERTAINTY_HIGH_THRESHOLD=0.70
UNCERTAINTY_MEDIUM_THRESHOLD=0.40
MIN_EVIDENCE_QUALITY_FOR_DETERMINISTIC=0.75
MIN_RETRIEVAL_QUALITY_FOR_REASONING=0.55
HIGH_RISK_REQUIRES_VALIDATION=true
MAX_PROVIDER_CALLS_PER_ANALYSIS=2
MAX_LLM_INPUT_TOKENS=6000
MAX_LLM_OUTPUT_TOKENS=1500
MAX_RETRIEVAL_CALLS_PER_ANALYSIS=2
LLM_INPUT_COST_USD_PER_MILLION_TOKENS=
LLM_OUTPUT_COST_USD_PER_MILLION_TOKENS=
# OpenAI-specific aliases for the same pricing values.
OPENAI_INPUT_COST_PER_1M_TOKENS=
OPENAI_OUTPUT_COST_PER_1M_TOKENS=
EMBEDDING_COST_USD_PER_MILLION_TOKENS=
ROUTING_POLICY_NAME=confidence_cost_policy
ROUTING_POLICY_VERSION=v1

# Module 9 hybrid retrieval (experimental; weights are heuristic).
# Modes: embedding_only | hybrid_static | hybrid_with_history | keyword_only
DEFAULT_RETRIEVAL_MODE=hybrid_static
ENABLE_HYBRID_RETRIEVAL=true
# Historical retrieval is organisation-scoped and disabled by default.
ENABLE_HISTORICAL_RETRIEVAL=false
ENABLE_LEXICAL_RETRIEVAL=true
ENABLE_STACK_TRACE_SIMILARITY=true
ENABLE_RETRIEVAL_DIVERSITY=true
HYBRID_WEIGHT_PROFILE=hybrid_static_v1
MIN_CANDIDATE_SCORE=0.35
MIN_SEMANTIC_SCORE=0.20
MIN_HISTORY_QUALITY_SCORE=0.70
MAX_CANDIDATES_BEFORE_RERANK=30
MAX_FINAL_RETRIEVAL_RESULTS=6
MAX_CHUNKS_PER_DOCUMENT=2
MAX_HISTORICAL_RESULTS=2
DIVERSITY_LAMBDA=0.75

# Phase 6A.1 — artifact bundle + deep parsers (causal pipeline foundation).
# All OFF by default. Existing rules/RAG/LLM analysis remains the fallback.
CAUSAL_ANALYSIS_ENABLED=false
ARTIFACT_BUNDLE_ENABLED=false
ARTIFACT_PARSING_ENABLED=false
GITHUB_ARTIFACT_ACQUISITION_ENABLED=false
ARTIFACT_MAX_CONTENT_CHARS=500000
# Verifier binaries (actionlint/terraform/checkov) are never executed in 6A.1.
# Probe status is UNAVAILABLE/DISABLED — never record a fake PASS.

# Phase 6A.2 — temporal localisation + evidence graph (structural/temporal evidence only).
# Does NOT generate causal hypotheses. All OFF by default.
TEMPORAL_LOCALISATION_ENABLED=false
EVIDENCE_GRAPH_ENABLED=false
GRAPH_CONSISTENCY_ENABLED=false
EVIDENCE_GRAPH_MAX_NODES=2000
EVIDENCE_GRAPH_MAX_EDGES=5000
TEMPORAL_MAX_EVENTS=5000

# Phase 5B — automated GitHub Actions ingestion (ADR-005).
# Disabled by default; manual upload always remains available.
# GITHUB_APP_PRIVATE_KEY_PATH / GITHUB_APP_PRIVATE_KEY_PEM and GITHUB_WEBHOOK_SECRET
# are server-side only and must never be exposed to an API response or the frontend.
GITHUB_APP_ENABLED=false
# github | fake (fake is a deterministic test double and is rejected in production)
GITHUB_PROVIDER=github
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_NAME=DevGuard AI
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY_PEM=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_APP_INSTALL_BASE_URL=https://github.com/apps
GITHUB_SETUP_REDIRECT_URL=http://localhost:5173/integrations/github/setup
# Phase 5C invitations (copyable links; SMTP deferred)
INVITATION_TTL_HOURS=168
INVITATION_ACCEPT_BASE_URL=http://localhost:5173/invitations/accept
FRONTEND_PUBLIC_URL=http://localhost:5173
GITHUB_API_TIMEOUT_SECONDS=20
GITHUB_INSTALLATION_TOKEN_BUFFER_SECONDS=120
GITHUB_SETUP_STATE_TTL_SECONDS=900
# background | sync (sync is used by tests)
GITHUB_WEBHOOK_PROCESSING_MODE=background
GITHUB_MAX_DELIVERY_ATTEMPTS=3
GITHUB_MAX_LOG_ARCHIVE_BYTES=52428800
GITHUB_MAX_EXTRACTED_BYTES=104857600
GITHUB_MAX_LOG_FILES=25
GITHUB_MAX_SINGLE_LOG_BYTES=5242880
# Fernet key (urlsafe base64, 32 bytes). Required when GITHUB_APP_ENABLED=true in production.
INTEGRATION_ENCRYPTION_KEY=

# Development-only bootstrap seed (creates a default organization + owner user).
# NEVER enable in staging/production. BOOTSTRAP_OWNER_PASSWORD is required when enabled
# and is never logged.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_ORG_NAME=DevGuard Default
BOOTSTRAP_ORG_SLUG=default
BOOTSTRAP_OWNER_EMAIL=owner@devguard.local
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_FULL_NAME=DevGuard Owner
