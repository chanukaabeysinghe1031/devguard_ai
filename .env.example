# Application
APP_NAME=DevGuard AI
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-secure-random-string-min-32-chars
API_V1_PREFIX=/api/v1

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=devguard
POSTGRES_PASSWORD=devguard_secret
POSTGRES_DB=devguard_ai
DATABASE_URL=postgresql+asyncpg://devguard:devguard_secret@localhost:5432/devguard_ai

# ChromaDB (Vector Store)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./backend/data/chroma

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ML
ML_MODEL_DIR=./backend/data/models
ML_DEFAULT_CLASSIFIER=logistic_regression

# Upload limits
MAX_UPLOAD_SIZE_MB=50
ALLOWED_LOG_EXTENSIONS=.log,.txt
ALLOWED_CONFIG_EXTENSIONS=.yml,.yaml,.tf,.hcl,.json

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
