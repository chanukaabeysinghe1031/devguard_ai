{
  "Version": "2012-10-17",
  "Id": "ci-deploy-policy",
  "Statement": [
    {
      "Sid": "AllowS3List",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::app-logs"
      ]
    },
    {
      "Sid": "DenyCreateBucket",
      "Effect": "Deny",
      "Action": "s3:CreateBucket",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}
