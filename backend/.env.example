PROJECT_NAME=DevGuard AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

POSTGRES_DB=devguard
POSTGRES_USER=devguard
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://devguard:change_me@postgres:5432/devguard

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

BACKEND_CORS_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO

# Development-only bootstrap seed (creates a default organization + owner user).
# NEVER enable in staging/production. BOOTSTRAP_OWNER_PASSWORD is required when enabled
# and is never logged.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_ORG_NAME=DevGuard Default
BOOTSTRAP_ORG_SLUG=default
BOOTSTRAP_OWNER_EMAIL=owner@devguard.local
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_FULL_NAME=DevGuard Owner
