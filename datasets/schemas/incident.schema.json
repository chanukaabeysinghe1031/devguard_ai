{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devguard.ai/schemas/incident.schema.json",
  "title": "DevGuardIncident",
  "description": "Curated or collected CI/CD failure incident for the RAG knowledge corpus and retrieval benchmark. Separate from runtime PostgreSQL incident tables.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "source_type",
    "title",
    "description",
    "technology",
    "failure_category",
    "provenance",
    "collection"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "minLength": 3,
      "description": "Stable ID, e.g. gh-actions-runner-12345"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "public_github_issue",
        "official_documentation",
        "reproduced",
        "synthetic",
        "curated_manual"
      ]
    },
    "repository": {
      "type": ["string", "null"],
      "description": "owner/name for GitHub sources"
    },
    "issue_number": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "issue_url": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Sanitised issue body or incident narrative"
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "symptoms": {
      "type": ["string", "null"]
    },
    "root_cause": {
      "type": ["string", "null"],
      "description": "Filled during curation when clearly stated"
    },
    "resolution": {
      "type": ["string", "null"],
      "description": "Filled during curation when a clear fix exists"
    },
    "technology": {
      "type": "string",
      "enum": [
        "github_actions",
        "docker",
        "terraform",
        "aws",
        "kubernetes",
        "python",
        "java",
        "node",
        "npm",
        "maven",
        "gradle",
        "networking",
        "authentication",
        "other"
      ]
    },
    "failure_category": {
      "type": "string",
      "description": "Must use frozen DevGuard taxonomy codes",
      "enum": [
        "build_failure",
        "test_failure",
        "dependency_failure",
        "configuration_failure",
        "terraform_failure",
        "docker_failure",
        "deployment_failure",
        "aws_permission_failure",
        "network_failure",
        "security_misconfiguration",
        "unknown_failure"
      ]
    },
    "severity": {
      "type": ["string", "null"],
      "enum": ["low", "medium", "high", null]
    },
    "state": {
      "type": ["string", "null"],
      "enum": ["open", "closed", null]
    },
    "resolved": {
      "type": "boolean",
      "default": false,
      "description": "Prefer true for the curated 300–600 benchmark"
    },
    "secrets_masked": {
      "type": "boolean",
      "default": false
    },
    "secrets_masked_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "collection_date",
        "license_or_usage_basis",
        "modified"
      ],
      "properties": {
        "source_url": { "type": "string" },
        "collection_date": {
          "type": "string",
          "description": "ISO-8601 date or datetime"
        },
        "license_or_usage_basis": {
          "type": "string",
          "description": "e.g. public GitHub issue under repository license; fair use for research"
        },
        "modified": {
          "type": "boolean",
          "description": "True if body was edited beyond secret masking"
        },
        "collector": {
          "type": "string",
          "default": "scripts/dataset/collect_github_issues.py"
        },
        "github_created_at": { "type": ["string", "null"] },
        "github_closed_at": { "type": ["string", "null"] },
        "github_updated_at": { "type": ["string", "null"] }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_version", "status"],
      "properties": {
        "dataset_version": { "type": "string" },
        "status": {
          "type": "string",
          "enum": [
            "raw_collected",
            "sanitised",
            "curation_candidate",
            "curated",
            "rejected"
          ]
        },
        "curation_notes": { "type": ["string", "null"] },
        "reject_reason": { "type": ["string", "null"] }
      }
    },
    "raw_metadata": {
      "type": "object",
      "description": "Non-secret GitHub metadata retained for research provenance",
      "additionalProperties": true
    }
  }
}
