{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devguard.ai/schemas/retrieval_query.schema.json",
  "title": "DevGuardRetrievalQuery",
  "description": "Labeled retrieval evaluation query. Used after the curated corpus exists (Precision@5, Recall@5, MRR, nDCG).",
  "type": "object",
  "additionalProperties": false,
  "required": ["query_id", "query_text", "relevant_incident_ids"],
  "properties": {
    "query_id": { "type": "string" },
    "query_text": { "type": "string", "minLength": 3 },
    "incident_sample_id": {
      "type": ["string", "null"],
      "description": "Optional link to a failure-dataset sample"
    },
    "relevant_incident_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "relevant_chunk_ids": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "relevance_grades": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 3
      }
    },
    "technology": { "type": ["string", "null"] },
    "failure_category": { "type": ["string", "null"] }
  }
}
